{
  "services": {
    "backend": {
      "build": {
        "dockerfile": "backend/Dockerfile"
      },
      "environment": {
        "PORT": "5000",
        "NODE_ENV": "production"
      }
    },
    "frontend": {
      "build": {
        "dockerfile": "frontend/Dockerfile",
        "args": {
          "VITE_API_URL": "$BACKEND_URL/api"
        }
      },
      "environment": {}
    }
  }
}
