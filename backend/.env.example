# Server
PORT=5000
NODE_ENV=development

# Must match the frontend's dev server URL so CORS allows requests through
CORS_ORIGIN=http://localhost:5173

# IBM Cloudant — get these from your Cloudant instance's "Service credentials"
# in IBM Cloud (see README.md "IBM Cloudant setup"). Leave both blank to run
# against a temporary in-memory store instead (data is lost on restart —
# fine for a quick frontend hack, not for anything you want to keep).
CLOUDANT_URL=
CLOUDANT_API_KEY=
CLOUDANT_DATABASE=taskmanager

# Required for authentication (JWT signing/verification). Generate one with:
#   openssl rand -base64 32
# The server refuses to start without this set.
JWT_SECRET=
